__pycache__/
*.py[cod]
.venv/
venv/

# マシンごとのローカル設定（共有しない）
.claude/settings.local.json

# render の出力（必要になったら生成する）
docs/graph.mmd
docs/graph.json
docs/graph.dot

.DS_Store
.idea/
.vscode/

# --------------------------------------------------------------------------
# 実装（統合型リポジトリ）
# --------------------------------------------------------------------------
# **秘密は絶対に版管理に入れない。** 例だけを .env.example として置く。
.env
.env.*
!.env.example
*/.env

# Node / TypeScript
node_modules/
dist/
build/
*.tsbuildinfo

# Python
.pytest_cache/
*.egg-info/

# 実行時にできるもの（運用データはリポジトリに置かない）
logs/
*.db
*.sqlite3

# HTML の生成物（CI が作る）
/_site/

# clasp の配置先指定。CI はリポジトリ変数 SCRIPT_ID から作る。
# 手元で clasp を使うときだけ作る。**認証情報は ~/.clasprc.json にあり、
# リポジトリには絶対に置かない。**
/.clasp.json
